# Neon PostgreSQL — chaîne serveur uniquement.
DATABASE_URL=postgresql://user:password@example.neon.tech/planoria?sslmode=require

# Assistant IA — utilisez une vraie clé uniquement dans .env.local.
GROQ_API_KEY=replace-with-your-groq-api-key

# Better Auth.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3031

# Envoi des codes OTP avec Resend.
EMAIL_MODE=resend-test
TEST_ALLOWED_EMAIL=admin@example.com
EMAIL_FROM=Planoria <onboarding@example.com>
RESEND_API_KEY=replace-with-your-resend-api-key
